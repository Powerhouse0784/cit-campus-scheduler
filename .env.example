# Groq API key — used by /api/ai/parse for natural-language booking intent extraction.
# Model: llama3-8b-8192. Falls back to deterministic rule-based parser if not set.
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# OpenAI API key — reserved for future integration; not currently called.
OPENAI_API_KEY=

# Public base URL used when an absolute application URL is required.
NEXT_PUBLIC_APP_URL=http://localhost:3000
