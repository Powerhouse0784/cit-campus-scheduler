# Groq API key — used by /api/ai/parse for natural-language booking intent extraction.
# Model: llama3-8b-8192. Falls back to deterministic rule-based parser if not set.
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# OpenAI API key — reserved for future integration; not currently called.
OPENAI_API_KEY=

# Public base URL used when an absolute application URL is required.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for production signed authentication cookies. Generate with:
# openssl rand -base64 48
CIT_AUTH_SECRET=

# Durable serverless persistence (server-side only; NEVER use NEXT_PUBLIC_ for a secret)
# Project URL supplied for this deployment:
SUPABASE_URL=https://mrkgqxaetsvkncrcxagz.supabase.co
# Supabase Dashboard -> Project Settings -> API Keys -> Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=
# Optional legacy fallback only: Project Settings -> API Keys -> service_role (JWT)
# Prefer SUPABASE_SECRET_KEY for new deployments.
SUPABASE_SERVICE_ROLE_KEY=
