# Groq API key — used server-side by /api/ai/parse when configured.
GROQ_API_KEY=
# Optional model override. Verify availability in your Groq account before deployment.
GROQ_MODEL=llama3-8b-8192

# Reserved for a future integration; the app does not call OpenAI currently.
OPENAI_API_KEY=

# Public base URL used when an absolute application URL is required.
NEXT_PUBLIC_APP_URL=http://localhost:3000
