# Copy this file to .env.local for local development.
# Never commit .env/.env.local or put server secrets in NEXT_PUBLIC_* variables.

# Required for durable Supabase persistence.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Preferred server-only key from Supabase Project Settings > API Keys.
# Use an sb_secret_... key. Do not use an sb_publishable_... key here.
SUPABASE_SECRET_KEY=REPLACE_WITH_YOUR_SERVER_SECRET

# Optional legacy alternative if your project still uses a service_role JWT.
# Use this OR SUPABASE_SECRET_KEY, not both.
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_JWT


# Optional: use a random secret of at least 32 characters in hosted environments.
CIT_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Optional AI provider key used by configured assistant features.
GROQ_API_KEY=
