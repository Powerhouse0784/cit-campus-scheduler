# Copy this file to .env.local for local development. Never commit real keys.

# Supabase project URL (the same project configured in your Supabase dashboard)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Preferred server-only Supabase secret key. Never use a secret/service-role key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Legacy alternative if your deployment still uses a service-role JWT (leave unset when using SUPABASE_SECRET_KEY).
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# Optional: public URL used by client-side Supabase features, if enabled by your setup.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Optional AI parsing/assistant provider key. AI endpoints may use deterministic/local behavior when absent.
# GROQ_API_KEY=YOUR_GROQ_API_KEY

# Optional: set a long random secret for the app's local/demo authentication.
# CIT_AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
